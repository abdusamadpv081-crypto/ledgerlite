# Local development only. Do not commit real values.
DATABASE_URL=postgresql://ledgerlite:ledgerlite@localhost:5432/ledgerlite
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_PORT=3000
OTEL_SERVICE_NAME=ledgerlite-api
# Local demo only. Never enable this on a shared or production environment.
LEDGERLITE_ENABLE_DEVELOPMENT_CATALOG=false

# Optional OIDC sign-in. Set every OIDC variable together; production values
# must use HTTPS. The transaction key is a unique base64url-encoded 32-byte
# secret kept in secret storage, never committed.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_TRANSACTION_ENCRYPTION_KEY=
