{
  "name": "@ledgerlite/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "corepack pnpm --filter @ledgerlite/domain build && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "corepack pnpm --filter @ledgerlite/domain build && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "^10.1.2",
    "@ledgerlite/db": "workspace:*",
    "@ledgerlite/domain": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "fastify": "^5.11.2",
    "openid-client": "6.8.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.6",
    "vitest": "^3.0.0"
  }
}
